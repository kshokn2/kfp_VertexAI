# Base image
FROM python:3.10-bullseye

# Test apt
RUN ls -al /etc/apt
RUN apt-get moo

# Set the working directory inside the container
RUN mkdir -p /workspace
WORKDIR /workspace

# Copy the entire project structure to the container
COPY ./workspace .

# Install the Python dependencies
RUN pip3 install -r pipeline/my-mlops/requirements.txt
# RUN pip3 install -r pipeline/my-run-job/requirements.txt

# Essential environment
ENV PYTHONPATH="/workspace"

# Sets up the entry point to invoke the trainer.
# ENTRYPOINT ["python", "pipeline/my-run-job/main.py"]
ENTRYPOINT ["python", "pipeline/my-mlops/main.py"]
